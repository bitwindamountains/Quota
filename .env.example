# Defaults to loopback only. Never put secrets in VITE_* variables.
PORT=4317
# Optional absolute data directory; defaults to OS application data.
# AI_TRACKER_DATA_DIR=
# Codex executable path if it is not on PATH (no surrounding quotes needed).
# CODEX_EXECUTABLE=
# OpenRouter key stays on the server; select Automatic when adding OpenRouter.
# OPENROUTER_API_KEY=

# Optional per-source names selected in Source settings (server-only; never VITE_*).
# QUOTA_OPENROUTER_WORK=your-key-here
# .env is plaintext. UI key entry uses Windows DPAPI instead.

# Optional reset reminder email (server-only; restart after changes).
# Use your mail provider's SMTP credentials / app password.
# QUOTA_SMTP_HOST=smtp.example.com
# QUOTA_SMTP_PORT=587
# QUOTA_SMTP_USER=your-smtp-user
# QUOTA_SMTP_PASSWORD="your-app-password"
# QUOTA_SMTP_FROM=you@example.com
# Port 587 requires STARTTLS; port 465 uses TLS immediately. Certificates are verified.
# Recipient addresses are selected per reset alarm in the dashboard.

# Additional reporting credentials: explicitly select environment mode in Source settings.
# Ordinary inference keys do not replace organization/team admin reporting credentials.
# OPENAI_ADMIN_KEY=
# ANTHROPIC_ADMIN_KEY=
# CURSOR_API_KEY=
# GITHUB_COPILOT_TOKEN=
# MISTRAL_ADMIN_KEY=
# DEEPSEEK_API_KEY=
# Per-source alternatives: QUOTA_OPENAI_WORK, QUOTA_ANTHROPIC_WORK,
# QUOTA_CURSOR_WORK, QUOTA_COPILOT_PERSONAL, QUOTA_MISTRAL_WORK, QUOTA_DEEPSEEK_PERSONAL.
# See docs/integrations/key-providers.md for permissions and report scope.
